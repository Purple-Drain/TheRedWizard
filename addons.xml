<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
	<addon id="plugin.video.redlight" name="[COLOR red]Red Light[/COLOR]" provider-name="[COLOR red]The Red Wizard[/COLOR]" version="2.2.0+pd.70">
	    <requires>
	        <import addon="xbmc.python" version="3.0.1"/>
	        <import addon="script.module.pil" version="1.1.7"/>
	        <import addon="script.module.requests" version="2.19.1"/>
	    </requires>
	    <extension point="xbmc.python.pluginsource" library="resources/lib/redlight.py">
	        <provides>video</provides>
	    </extension>
	    <extension point="xbmc.service" library="resources/lib/service.py"/>
	    <extension point="xbmc.python.module" library="resources/lib/"/>
	    <extension point="xbmc.addon.metadata">
	        <reuselanguageinvoker>false</reuselanguageinvoker>
	        <summary lang="en">[COLOR red]The Red Light[/COLOR]</summary>
	        <description lang="en">[COLOR red]* AllDebrid, Offcloud, Premiumize, Real Debrid and TorBox
	* AIOStreams
	* EasyNews, NZB Indexers and Local Folders
	* MDBList, PunchPlay, Simkl, TMDb Lists, Trakt and WeTrakr[/COLOR]</description>
	        <platform>all</platform>
	        <disclaimer lang="en">[COLOR red]The author of this add-on does not host any content and has no affiliation with the content providers[/COLOR]</disclaimer>
	        <license>GPL-3.0</license>
	        <assets>
	            <icon>resources/media/addon_icons/icon.png</icon>
	            <fanart>resources/media/fanart.jpg</fanart>
	        </assets>
	        <news>[COLOR red]Check the Changelog in Tools > Changelog &amp; Log Utils[/COLOR]</news>
	    </extension>
	</addon>
	<addon id="repository.purpledrain" name="Purple Drain Fork Repo" version="1.2.0" provider-name="Purple-Drain">
	    <extension point="xbmc.addon.repository" name="Purple Drain Fork Repo">
	        <dir>
	            <info compressed="false">https://purple-drain.github.io/TheRedWizard/addons.xml</info>
	            <checksum>https://purple-drain.github.io/TheRedWizard/addons.xml.md5</checksum>
	            <datadir zip="true">https://purple-drain.github.io/TheRedWizard/</datadir>
	        </dir>
	        <dir>
	            <info compressed="false">https://purple-drain.github.io/skin.arctic.fuse.3/addons.xml</info>
	            <checksum>https://purple-drain.github.io/skin.arctic.fuse.3/addons.xml.md5</checksum>
	            <datadir zip="true">https://purple-drain.github.io/skin.arctic.fuse.3/</datadir>
	        </dir>
	        <dir>
	            <info compressed="false">https://purple-drain.github.io/plugin.video.beinsports.apac/addons.xml</info>
	            <checksum>https://purple-drain.github.io/plugin.video.beinsports.apac/addons.xml.md5</checksum>
	            <datadir zip="true">https://purple-drain.github.io/plugin.video.beinsports.apac/</datadir>
	        </dir>
	    </extension>
	    <extension point="xbmc.addon.metadata">
	        <summary lang="en">Purple-Drain fork add-ons: Redlight, Arctic Fuse 3 and beIN Sports Connect</summary>
	        <description lang="en">Serves plugin.video.redlight from the Purple-Drain fork (github.com/Purple-Drain/TheRedWizard), skin.arctic.fuse.3 from the Purple-Drain skin fork (github.com/Purple-Drain/skin.arctic.fuse.3), and plugin.video.beinsports.apac from the Purple-Drain beIN fork (github.com/Purple-Drain/plugin.video.beinsports.apac), so all three update from the forks instead of upstream's repositories.</description>
	        <platform>all</platform>
	    </extension>
	</addon>
</addons>
