<?xml version="1.0" encoding="UTF-8"?>
<window>
    <onload>Dialog.Close(fullscreeninfo,true)</onload>
    <onload condition="!String.IsEqual(Window.Property(osd_mode),true)">Dialog.Close(videoosd,true)</onload>
