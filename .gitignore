# Build output from tools/build-repo.sh -- release zips + repo index, never committed.
dist/

# Python bytecode. Kodi generates these on-device; they should never be in the repo.
__pycache__/
*.pyc
*.pyo

# Claude Code local session/tooling state -- never meant to be committed or pushed.
.claude/

# Local session handoff notes -- private, never meant to reach the fork or upstream.
CLAUDE.md
